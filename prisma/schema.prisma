generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  role_id     Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(30)
  description String  @db.VarChar(200)
  users       users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id                 BigInt    @id @default(autoincrement())
  first_name              String    @db.VarChar(100)
  last_name               String    @db.VarChar(100)
  email                   String    @unique @db.Citext
  password_hash           String    @db.VarChar(255)
  role_id                 Int       @db.SmallInt
  active                  Boolean   @default(true)
  last_login_at           DateTime? @db.Timestamptz(6)
  last_password_change_at DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)
  roles                   roles     @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([active], map: "idx_users_active")
  @@index([last_name, first_name], map: "idx_users_name")
  @@index([role_id], map: "idx_users_role")
}
